{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "backup_id",
    "created_at",
    "producer",
    "library_schema_version",
    "library"
  ],
  "properties": {
    "payload_version": {
      "const": 1
    },
    "backup_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app",
        "version"
      ],
      "properties": {
        "app": {
          "const": "Pinleaf"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "library_schema_version": {
      "const": 6
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "groups",
        "notes",
        "profile_context",
        "active_context",
        "app_settings"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "urn:pinleaf:backup-payload:1#/$defs/profile"
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "urn:pinleaf:backup-payload:1#/$defs/group"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100000,
          "items": {
            "$ref": "urn:pinleaf:backup-payload:1#/$defs/note"
          }
        },
        "profile_context": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "urn:pinleaf:backup-payload:1#/$defs/context"
          }
        },
        "active_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "group_id"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "group_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "app_settings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "enum": [
                  "default_font_family",
                  "default_font_size",
                  "default_text_color"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
